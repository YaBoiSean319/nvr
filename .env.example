NVR_PORT=8080
NVR_SESSION_HOURS=12
# Enable when TLS terminates in the approved workplace gateway.
NVR_COOKIE_SECURE=false
# Set this to the externally reachable HTTPS origin when Entra sign-in is enabled.
# Register https://nvr.example.com/api/auth/oidc/callback as the web redirect URI.
# NVR_PUBLIC_URL=https://nvr.example.com
# NVR_OIDC_TENANT_ID=00000000-0000-0000-0000-000000000000
# NVR_OIDC_CLIENT_ID=00000000-0000-0000-0000-000000000000
# NVR_OIDC_CLIENT_SECRET=replace-with-a-secret-from-your-secret-manager
# Generate with: openssl rand -base64 48
# NVR_OIDC_SESSION_SECRET=replace-with-a-long-random-secret
# Map Entra app-role values (comma-separated) to NVR roles. Unmapped accounts are denied.
# NVR_OIDC_ADMIN_ROLES=NVR.Administrator
# NVR_OIDC_OPERATOR_ROLES=NVR.Operator
# Internal volume path; do not set this to a file under the database volume.
NVR_CREDENTIAL_KEY_PATH=/secrets/credentials.key
